{
  "name": "dsh-agent-man",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-session memory plugin skeleton for DeepSeek Harness.",
  "type": "module",
  "main": "./index.mjs",
  "icon": "./icon.svg",
